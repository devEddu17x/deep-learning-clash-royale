# Configuración para scripts/sync_to_r2.py
# Copia este archivo a .env y llena los valores reales: cp .env.example .env

# Credenciales Cloudflare R2 (API compatible con S3)
R2_ENDPOINT=https://<TU_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=cr-videos

# Token de administración del annotator
ADMIN_TOKEN=

# URLs públicas (opcionales)
ANNOTATOR_URL=https://cr-dataset.eddux.dev
CDN_URL=https://cdn-cr.eddux.dev

